# Azure app registration (personal and organizational Microsoft accounts).
BING_ADS_CLIENT_ID=
BING_ADS_DEVELOPER_TOKEN=
# Optional for confidential/web apps. Public desktop apps do not need a secret.
BING_ADS_CLIENT_SECRET=
# Seed a refresh token here OR run: uv run bing-ads-login
BING_ADS_REFRESH_TOKEN=
BING_ADS_ENVIRONMENT=production
BING_ADS_READ_ONLY=false
# Paths are relative to the launch directory; use absolute paths in deployments.
BING_ADS_TOKEN_FILE=.bing-ads/token.json
BING_ADS_EXPORT_DIR=.bing-ads/exports
