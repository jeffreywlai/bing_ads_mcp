{
  "mcpServers": {
    "BingAds": {
      "command": "uvx",
      "args": [
        "--refresh",
        "--python",
        "3.15",
        "--from",
        "git+https://github.com/jeffreywlai/bing_ads_mcp.git@main",
        "bing-ads-mcp"
      ],
      "env": {
        "BING_ADS_CLIENT_ID": "",
        "BING_ADS_DEVELOPER_TOKEN": "",
        "BING_ADS_TOKEN_FILE": "~/.bing-ads/token.json",
        "BING_ADS_EXPORT_DIR": "~/.bing-ads/exports"
      }
    }
  }
}
